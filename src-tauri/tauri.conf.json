{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance",
  "version": "1.0.1",
  "identifier": "app.resonance.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Desktop player for YouTube Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "homepage": "https://github.com/PoisonTheIgiData/Ressonance-YT-Music",
    "license": "Apache-2.0",
    "longDescription": "Resonance wraps YouTube Music in a Spotify-style desktop interface with a taskbar player, mini player, synced lyrics, equalizer and phone remote."
  }
}
